# URL de json-server (npm run api)
VITE_API_URL=http://localhost:3001

# Recomendador con IA (Google Gemini, capa gratuita). Solo se usa en el servidor.
# Consigue la key gratis en https://aistudio.google.com/apikey
# Sin key, el recomendador funciona igual con reglas (sin IA).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Imágenes en RustFS (docker compose up -d). Valores por defecto del compose.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=images
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
# URL pública desde la que el navegador carga las imágenes (por defecto, S3_ENDPOINT)
# S3_PUBLIC_URL=http://localhost:9000
